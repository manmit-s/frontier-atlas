# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and temporary data
.pytest_cache/
.coverage
htmlcov/
*.log
data/temp/
data/cache/
*.tmp

# Environment variables & secrets
.env
*.pem
*.key
credentials.json
