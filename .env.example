# ==============================================================================
# AI Engineer Demo Task - Environment Configuration
# ==============================================================================

# LLM Provider API Keys (Leave blank for offline/deterministic extraction mode)
GEMINI_API_KEY=AQ.Ab8RN6KeYxMEkyVtDXDnMw2HzYbdyo_kftfEjKS_sik8b44bDw
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Configurable LLM Model Identifiers
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_MODEL=deepseek-chat

# LLM Fallback & Context Window Settings
MAX_INPUT_CHARS=12000
MAX_CHUNK_CHARS=4000
MAX_OUTPUT_TOKENS=1024
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF=1.5
LLM_MAX_BACKOFF=30.0

# GitHub Integration (Optional: improves rate limits from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Google Sheets Export (Optional: leave blank to export to local data/sheets_export/)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Database Configuration (Local SQLite default; PostgreSQL in production)
DATABASE_URL=sqlite:///data/intelligence.db

# Crawler & Networking Configuration
MAX_CONCURRENCY=15
REQUEST_TIMEOUT=20
CRAWLER_MAX_RETRIES=3
CRAWLER_BASE_BACKOFF=1.0
CRAWLER_MAX_BACKOFF=15.0

# Storage & Disk Usage Safeguards (Strict < 1 GB Constraint)
MAX_PROJECT_FOOTPRINT_MB=900
MAX_TEMP_STORAGE_MB=150
MAX_SINGLE_TEMP_FILE_MB=25

# Entity Resolution Thresholds
FUZZY_CONFIDENCE_THRESHOLD=88.0
FUZZY_REVIEW_THRESHOLD=75.0
